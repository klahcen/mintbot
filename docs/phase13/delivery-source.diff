+entry, exit = funnel['paperEntries'], funnel['paperExits']
+log = (OUT / 'delivery-validation/after-tests.log').read_text()
+tests = re.search(r'# tests (\d+).*?# pass (\d+).*?# fail (\d+)', log, re.S)
