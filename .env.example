HOST=127.0.0.1
PORT=3001
# Generate with openssl rand -hex 32. Required for every mutation and state access.
API_TOKEN=
MODE=paper
INITIAL_BALANCE_SOL=10
STATE_PATH=data/state.json
# Optional read-only chain monitoring
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Optional second provider; same stable identities and shared bounded journal.
SOLANA_SECONDARY_WS_URL=
# Server default; standalone CLI defaults to data/monitor-ingestion.wal.
INGESTION_JOURNAL_PATH=data/server-ingestion.wal
MONITOR_PROGRAMS=
# Optional event audit persistence. Schema must be installed first.
DATABASE_URL=
# Optional notification destination; configured operator only. Never accept chat IDs from API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Live routes are deliberately unavailable until protocol adapters and signer audit pass.

# Required only for Docker Compose. Use a URL-safe random hex password.
POSTGRES_PASSWORD=

# Separate, read-only quote-backed paper ledger. Disabled by default; no signer.
REAL_MARKET_PAPER=false
MARKET_PAPER_STATE_PATH=data/market-paper-state.json
# Entry-age profile only; all risk/finality/quote-expiry gates remain mandatory.
# Optional explicit research profile: finalized-paper-research (60 seconds / 160 slots).
MARKET_RESEARCH_POLICY=strict-finalized

# Explicit Phase10 research deployment overlay; legacy server monitoring stays separate.
# docker compose -f compose.yaml -f compose.research.yaml --profile research up
# A stopped run is retained; select a new run name for a new bounded experiment.
RESEARCH_RUN_NAME=run
RESEARCH_STATUS_PATH=
SOLANA_SECONDARY_RPC_URL=https://solana-rpc.publicnode.com

# Explicit Phase11 research overlay only. Independent coverage-policy review remains unmet.
RESEARCH_SECONDS=1800
RESEARCH_VENUES=pump,pumpswap,raydium-cpmm,meteora-dlmm
# RESEARCH_STOP_PATH=/app/research-control/global-stop.json

# Cloud deployment uses separate cloud.env (public settings) and private file secrets.
# See docs/cloud-deployment.md; do not merge compose.cloud.yaml with local Compose.
