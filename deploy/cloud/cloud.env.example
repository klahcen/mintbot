# Public configuration only. Never put credentials here.
MINTBOT_IMAGE=mintbot:phase19
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
MINTBOT_DOMAIN=dashboard.example.com
ACME_EMAIL=operator@example.com
RESEARCH_RUN_NAME=run
RESEARCH_SECONDS=1800
# Host maintenance configuration (also public).
BACKUP_DIR=/var/backups/mintbot
BACKUP_CERT=/etc/mintbot/backup-recipient.pem
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
MIN_DISK_FREE_GB=5
